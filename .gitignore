# ---- Large external assets (fetch via scripts/download_data.py) ----
# Anchored to the repository root: paper/*/data/ holds the small per-stage
# inputs (DREAM team predictions, Griner blocks, wet-lab manifests) and stays
# tracked.
/data/
/weights/
vendor/grover/
vendor/cooclassifier/

# ---- Model checkpoints ----
*.pth
*.pt
*.ckpt
!example/model/*.pth

# ---- Experiment tracking / scratch ----
wandb/
runs/
logs/
tmp/
checkpoint/

# ---- Bulky derived results (keep only the curated tables under paper/) ----
# Anchored to the repository root: paper/*/results/ holds the small result
# tables behind each figure and must stay tracked.
/results/
*.bz2
*.npz
*.npy
!paper/**/*.npy
!example/**/*.npy
!example/**/*.npz

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.executed.ipynb

# local recompute outputs
**/errorbar_intervals.from_predictions.csv

